{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++23: cpp23_app 디버그",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/cpp23_app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
